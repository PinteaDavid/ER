{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configurează (CMake)",
      "type": "shell",
      "command": "cmake -S . -B build -DCMAKE_BUILD_TYPE=Debug -DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Compilează",
      "type": "shell",
      "command": "cmake --build build -j",
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "Configurează (CMake)",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Rulează",
      "type": "shell",
      "command": "./build/descompunere",
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "Compilează",
      "problemMatcher": []
    }
  ]
}
